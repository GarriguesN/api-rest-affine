# Server
PORT=3002
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Auth del microservicio (x-api-key)
# Genera una cadena larga y aleatoria, ej:
#   openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# Affine
# URL base de tu instancia (sin trailing slash)
AFFINE_BASE_URL=https://notes.nglab.es
# Endpoint GraphQL (normalmente /graphql en la raíz)
AFFINE_GRAPHQL_URL=https://notes.nglab.es/graphql
# Credenciales de la cuenta de servicio en Affine
AFFINE_EMAIL=hermes@nglab.es
AFFINE_PASSWORD=__set_in_real_env__

# Sesión (opcional — si no se proporcionan, se hace login automático al arrancar)
# Para obtenerlas: abre DevTools en Affine → Application → Cookies → copia affine_session y affine_csrf_token
AFFINE_SESSION_COOKIE=
AFFINE_CSRF_TOKEN=
